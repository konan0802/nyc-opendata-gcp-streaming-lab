# NYC Open Data API Configuration
# Get your App Token at: https://data.cityofnewyork.us/profile/edit/developer_settings
NYC_OPENDATA_APP_TOKEN=your_app_token_here

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Dataset Configuration
DATASET_ID=erm2-nwe9  # 311 Service Requests from 2020 to Present
API_ENDPOINT=https://data.cityofnewyork.us/resource/erm2-nwe9.json

# Pub/Sub Configuration
PUBSUB_TOPIC=nyc-opendata-raw

# BigQuery Configuration
BIGQUERY_DATASET=nyc_opendata
BIGQUERY_TABLE=service_requests_311

# Cloud Storage Configuration
STATE_BUCKET=your-project-state-bucket
STATE_FILE=last_fetch_time.txt

# Cloud Function Configuration
FUNCTION_TIMEOUT=540  # seconds (9 minutes)
FUNCTION_MEMORY=512   # MB
FETCH_INTERVAL=300    # seconds (5 minutes)
